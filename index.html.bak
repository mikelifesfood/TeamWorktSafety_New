<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="TeamWorkt Safety gives field teams a simple way to report safety concerns, assign corrective action, verify the work, and keep a complete record from report to closure.">
<title>TeamWorkt Safety | Simple Safety Reporting and Corrective Action</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --navy-950:#041525;
  --navy-900:#061a2f;
  --navy-850:#082846;
  --navy-800:#0a315d;
  --blue-700:#174f86;
  --blue-600:#1d66aa;
  --blue-500:#2a79bd;
  --blue-100:#e7f0f8;
  --blue-050:#f4f8fc;
  --ink:#102236;
  --muted:#60758b;
  --line:#d8e2ec;
  --paper:#fff;
  --surface:#f3f6fa;
  --ok:#1f7045;
  --shadow:0 26px 70px -42px rgba(5,35,63,.58);
  --sans:"Public Sans",system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  --display:"Archivo",var(--sans);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit}
button,a{font-family:inherit}
img{max-width:100%;display:block}
.container{width:min(1120px,calc(100% - 40px));margin:0 auto}
.site-header{position:sticky;top:0;z-index:50;background:rgba(6,26,47,.94);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,.09)}
.nav{min-height:72px;display:flex;align-items:center;gap:26px;color:#fff}
.brand{display:inline-flex;align-items:center;gap:11px;text-decoration:none;font-family:var(--display);font-weight:700;margin-right:auto}.brand img{height:44px;width:auto;display:block;filter:brightness(0) invert(1) drop-shadow(0 10px 22px rgba(0,0,0,.22))}.brand-name{font-size:17px}.brand-name b{font-weight:800}.header-logo{margin-left:8px;display:flex;align-items:center}.header-logo img{height:42px;width:auto;display:block;filter:brightness(0) invert(1) drop-shadow(0 10px 22px rgba(0,0,0,.22))}.footer-brand-logo{height:34px;width:auto;display:block;margin-bottom:8px;filter:brightness(0) invert(1) drop-shadow(0 8px 18px rgba(0,0,0,.18))}
.nav-links{display:flex;align-items:center;gap:24px;font-size:13px;font-weight:700;color:#d8e6f3}
.nav-links a{text-decoration:none}.nav-links a:hover{color:#fff}
.nav-cta{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:0 15px;border-radius:9px;background:#fff;color:#0a315d;text-decoration:none;font-family:var(--display);font-size:12px;font-weight:800}
.hero{position:relative;overflow:hidden;isolation:isolate;color:#fff;background:radial-gradient(circle at 82% 8%,rgba(74,151,220,.54),transparent 28%),radial-gradient(circle at 8% 92%,rgba(32,99,160,.23),transparent 34%),linear-gradient(145deg,#0b3b73 0%,#061a2f 67%,#041321 100%);padding:82px 0 96px}
.hero:before{content:"";position:absolute;z-index:0;top:0;right:0;bottom:0;width:61%;background-image:linear-gradient(180deg,rgba(17,82,143,.12) 0%,rgba(9,53,96,.24) 55%,rgba(5,31,56,.52) 100%),url("assets/teamworkt-construction-hero.webp");background-size:cover;background-position:right center;opacity:.58;-webkit-mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,.16) 14%,rgba(0,0,0,.72) 34%,#000 52%);mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,.16) 14%,rgba(0,0,0,.72) 34%,#000 52%);pointer-events:none}
.hero:after{content:"";position:absolute;z-index:0;inset:auto -10% -220px -10%;height:340px;border-radius:50%;background:rgba(255,255,255,.025);transform:rotate(-3deg)}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(470px,.98fr);gap:62px;align-items:center;position:relative;z-index:1}
.kicker{display:inline-flex;align-items:center;gap:8px;font-family:var(--display);font-size:11px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:#b9d8f3}
.kicker-dot{width:7px;height:7px;border-radius:50%;background:#72b4ef;box-shadow:0 0 0 5px rgba(114,180,239,.12)}
h1{font-family:var(--display);font-size:clamp(42px,6vw,72px);line-height:1.01;letter-spacing:-.045em;margin:17px 0 22px;max-width:760px}
.hero-copy{max-width:690px;font-size:18px;line-height:1.67;color:#d7e4f1;margin:0}
.hero-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:30px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 20px;border-radius:10px;text-decoration:none;font-family:var(--display);font-size:13px;font-weight:800;border:1px solid transparent;transition:transform .16s ease,box-shadow .16s ease,background .16s ease}
.btn:hover{transform:translateY(-2px)}
.btn-primary{background:linear-gradient(135deg,#2a79bd,#1d66aa 55%,#174f86);color:#fff;box-shadow:0 16px 32px -20px rgba(0,0,0,.85)}
.btn-primary:hover{box-shadow:0 22px 38px -20px rgba(0,0,0,.9)}
.btn-light{background:#fff;color:#103d6a}.btn-ghost{border-color:rgba(255,255,255,.24);color:#fff;background:rgba(255,255,255,.06)}
.hero-note{display:flex;gap:20px;flex-wrap:wrap;margin-top:26px;color:#aec4d9;font-size:12px;font-weight:600}.hero-note span{display:flex;align-items:center;gap:7px}.hero-note span:before{content:"";width:6px;height:6px;border-radius:50%;background:#66b1ee}
.product-stage{position:relative;min-height:505px}
.browser{position:absolute;background:#fff;border:1px solid rgba(193,217,238,.35);border-radius:18px;box-shadow:0 42px 90px -36px rgba(0,0,0,.9);overflow:hidden}
.browser-main{width:92%;right:0;top:10px;transform:rotate(.8deg);animation:drift 8s ease-in-out infinite}
.browser-phone{width:39%;left:0;bottom:0;z-index:3;border-radius:22px;transform:rotate(-1.5deg);animation:driftPhone 7s ease-in-out infinite}
.browser-bar{height:31px;background:#eaf0f6;border-bottom:1px solid #d4dfeb;display:flex;align-items:center;gap:6px;padding:0 11px}
.browser-bar .dot{width:7px;height:7px;border-radius:50%;background:#b8c6d5;display:block}
.browser-view{position:relative;background:#eef3f8;overflow:hidden}
.browser-main .browser-view{height:420px}.browser-phone .browser-view{height:325px}
.browser iframe{border:0;width:200%;height:200%;transform:scale(.5);transform-origin:0 0;pointer-events:none;background:#fff}
.browser-phone iframe{width:270%;height:270%;transform:scale(.37)}
.preview-tag{position:absolute;right:20px;bottom:18px;z-index:6;background:#061a2f;color:#fff;border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:7px 11px;font-family:var(--display);font-size:9px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;box-shadow:0 10px 28px -16px #000}
.preview-tag:before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;margin-right:6px;background:#65c18c;box-shadow:0 0 0 4px rgba(101,193,140,.16)}
@keyframes drift{0%,100%{transform:translateY(0) rotate(.8deg)}50%{transform:translateY(-8px) rotate(.3deg)}}
@keyframes driftPhone{0%,100%{transform:translateY(0) rotate(-1.5deg)}50%{transform:translateY(7px) rotate(-.6deg)}}
.section{padding:88px 0}.section.soft{background:var(--surface)}
.section-head{max-width:760px;margin-bottom:44px}.section-head.center{margin-left:auto;margin-right:auto;text-align:center}
.eyebrow{font-family:var(--display);font-size:11px;letter-spacing:.11em;text-transform:uppercase;font-weight:800;color:var(--blue-600)}
h2{font-family:var(--display);font-size:clamp(31px,4.4vw,50px);line-height:1.08;letter-spacing:-.035em;margin:10px 0 15px;color:var(--ink)}
.section-head p{font-size:17px;color:var(--muted);margin:0;max-width:720px}.section-head.center p{margin-left:auto;margin-right:auto}
.problem-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.problem{padding:24px;border:1px solid var(--line);border-radius:16px;background:#fff;box-shadow:0 15px 38px -34px rgba(6,40,72,.45)}
.problem-num{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;background:var(--blue-100);color:var(--blue-700);font-family:var(--display);font-weight:800;font-size:11px}
.problem h3{font-family:var(--display);font-size:17px;line-height:1.25;margin:18px 0 8px}.problem p{margin:0;color:var(--muted);font-size:14px;line-height:1.6}
.flow-shell{border-radius:24px;background:linear-gradient(145deg,#0b3b73,#061a2f 68%);padding:36px;color:#fff;box-shadow:var(--shadow)}
.flow-top{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:28px}.flow-top h2{color:#fff;margin:0;max-width:620px;font-size:clamp(28px,4vw,42px)}.flow-top p{max-width:390px;margin:0;color:#c9daea;font-size:14px}
.flow{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;position:relative}.flow:before{content:"";position:absolute;left:7%;right:7%;top:26px;height:2px;background:linear-gradient(90deg,rgba(91,165,226,.18),#66b1ee,rgba(91,165,226,.18));z-index:0}
.flow-step{position:relative;z-index:1;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.07);border-radius:13px;padding:17px 12px 15px;text-align:center;min-height:118px;animation:flowPulse 7.2s ease-in-out infinite}
.flow-step:nth-child(2){animation-delay:1.1s}.flow-step:nth-child(3){animation-delay:2.2s}.flow-step:nth-child(4){animation-delay:3.3s}.flow-step:nth-child(5){animation-delay:4.4s}.flow-step:nth-child(6){animation-delay:5.5s}
.flow-icon{width:29px;height:29px;border-radius:9px;margin:0 auto 12px;display:grid;place-items:center;background:#fff;color:#174f86;font-family:var(--display);font-size:10px;font-weight:800;box-shadow:0 8px 22px -15px #000}
.flow-step b{display:block;font-family:var(--display);font-size:12px;margin-bottom:4px}.flow-step span{display:block;font-size:10.5px;line-height:1.4;color:#b9cde0}.flow-mobile-controls{display:none}.flow-mobile-btn{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:999px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);color:#fff;font-family:var(--display);font-size:20px;font-weight:700;cursor:pointer}.flow-mobile-btn:hover{background:rgba(255,255,255,.15)}.flow-mobile-btn:disabled{opacity:.42;cursor:default}.flow-mobile-dots{display:flex;align-items:center;gap:8px}.flow-mobile-dot{width:9px;height:9px;border-radius:999px;border:0;background:rgba(255,255,255,.25);padding:0;cursor:pointer}.flow-mobile-dot.is-active{background:#7fc2ff;box-shadow:0 0 0 4px rgba(127,194,255,.14)}
@keyframes flowPulse{0%,14%,100%{transform:translateY(0);border-color:rgba(255,255,255,.14);background:rgba(255,255,255,.07)}7%{transform:translateY(-5px);border-color:rgba(112,186,245,.68);background:rgba(61,130,191,.24)}}
.split{display:grid;grid-template-columns:1fr 1fr;gap:68px;align-items:center}.split.reverse .split-copy{order:2}.split.reverse .live-frame{order:1}
.split-copy h2{margin-top:10px}.split-copy p{color:var(--muted);font-size:16px}.check-list{display:grid;gap:12px;margin-top:26px}.check{display:grid;grid-template-columns:26px 1fr;gap:11px;align-items:start}.check-dot{width:24px;height:24px;border-radius:8px;background:var(--blue-100);color:var(--blue-700);display:grid;place-items:center;font-size:12px;font-weight:900}.check b{display:block;font-family:var(--display);font-size:14px;margin-bottom:2px}.check span{display:block;color:var(--muted);font-size:13px}
.live-frame{border:1px solid var(--line);background:#fff;border-radius:20px;padding:10px;box-shadow:var(--shadow);position:relative}.live-frame:after{content:"LIVE PRODUCT VIEW";position:absolute;right:22px;bottom:20px;background:#061a2f;color:#fff;border-radius:999px;padding:6px 9px;font-family:var(--display);font-size:8px;font-weight:800;letter-spacing:.08em}.live-frame .browser-bar{border-radius:10px 10px 0 0}.live-window{height:390px;overflow:hidden;background:#eef3f8;border-radius:0 0 11px 11px}.live-window iframe{border:0;width:200%;height:200%;transform:scale(.5);transform-origin:0 0;pointer-events:none;background:#fff}
.setup{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.setup-card{position:relative;border:1px solid var(--line);border-radius:16px;background:#fff;padding:24px}.setup-card .n{font-family:var(--display);font-size:11px;font-weight:800;color:var(--blue-600);letter-spacing:.07em}.setup-card h3{font-family:var(--display);font-size:18px;margin:13px 0 7px}.setup-card p{margin:0;color:var(--muted);font-size:13.5px;line-height:1.6}
.access-section{background:linear-gradient(180deg,#fff,#f6f9fc)}.access-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.access-card{border:1px solid var(--line);border-radius:18px;background:#fff;padding:26px;box-shadow:0 16px 38px -34px rgba(6,40,72,.45)}.access-icon{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:var(--blue-100);color:var(--blue-700);font-family:var(--display);font-size:13px;font-weight:800}.access-card h3{font-family:var(--display);font-size:18px;line-height:1.3;margin:18px 0 8px}.access-card p{margin:0;color:var(--muted);font-size:13.5px;line-height:1.65}.url-pill{display:inline-flex;align-items:center;margin-top:16px;padding:8px 11px;border-radius:9px;background:#eef4fa;color:#174f86;font-family:var(--display);font-size:12px;font-weight:800;letter-spacing:.01em}
.necessity{background:linear-gradient(180deg,#f8fbfe,#f2f6fa);border-top:1px solid #e1e9f1;border-bottom:1px solid #e1e9f1}
.necessity-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:64px;align-items:start}.quote-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:30px;box-shadow:var(--shadow)}.quote-card strong{font-family:var(--display);display:block;font-size:22px;line-height:1.35;margin-bottom:12px}.quote-card p{margin:0;color:var(--muted);font-size:14px}.why-list{display:grid;grid-template-columns:1fr 1fr;gap:14px}.why{border:1px solid var(--line);background:#fff;border-radius:14px;padding:20px}.why h3{font-family:var(--display);font-size:15px;margin:0 0 7px}.why p{margin:0;color:var(--muted);font-size:13px;line-height:1.55}
.fit-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.fit{padding:9px 12px;border:1px solid var(--line);border-radius:999px;background:#fff;color:#38536c;font-size:12px;font-weight:700}
.cta-section{padding:78px 0;background:radial-gradient(circle at 80% 0,rgba(66,139,205,.42),transparent 34%),linear-gradient(145deg,#0b3b73,#061a2f 70%);color:#fff}.cta-box{display:flex;align-items:center;justify-content:space-between;gap:38px}.cta-copy{max-width:720px}.cta-copy .eyebrow{color:#b9d8f3}.cta-copy h2{color:#fff;margin-bottom:12px}.cta-copy p{color:#cadbea;margin:0;max-width:650px}.cta-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}
footer{background:#041321;color:#91a9bf;padding:26px 0;font-size:11.5px}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}.footer-brand{color:#e0ebf4;font-family:var(--display);font-weight:700}.footer-links{display:flex;gap:16px}.footer-links a{text-decoration:none}.footer-links a:hover{color:#fff}
.reveal{opacity:0;transform:translateY(18px);transition:opacity .65s ease,transform .65s ease}.reveal.visible{opacity:1;transform:translateY(0)}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}.browser-main,.browser-phone,.flow-step{animation:none}.reveal{opacity:1;transform:none;transition:none}}
@media(max-width:1000px){.hero-grid{grid-template-columns:1fr;gap:42px}.product-stage{min-height:480px;max-width:700px}.problem-grid,.setup{grid-template-columns:1fr 1fr}.access-grid{grid-template-columns:1fr}.flow{grid-template-columns:repeat(3,1fr)}.flow:before{display:none}.split,.necessity-grid{grid-template-columns:1fr;gap:42px}.split.reverse .split-copy,.split.reverse .live-frame{order:initial}.cta-box{align-items:flex-start;flex-direction:column}.cta-actions{justify-content:flex-start}}
@media(max-width:720px){.hero:before{top:0;right:0;bottom:0;width:74%;height:auto;background-position:83% center;opacity:.42;-webkit-mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,.16) 20%,rgba(0,0,0,.56) 48%,#000 70%);mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,.16) 20%,rgba(0,0,0,.56) 48%,#000 70%)}.container{width:min(100% - 28px,1120px)}.site-header{position:relative}.nav{min-height:64px}.nav-links{display:none}.nav-cta{font-size:11px;padding:0 11px;min-height:36px}.hero{padding:58px 0 68px}.hero-grid{gap:34px}h1{font-size:44px}.hero-copy{font-size:16px}.product-stage{min-height:400px}.browser-main{width:96%}.browser-main .browser-view{height:330px}.browser-phone{width:43%}.browser-phone .browser-view{height:250px}.section{padding:66px 0}.problem-grid,.setup,.why-list{grid-template-columns:1fr}.flow-shell{padding:26px 18px}.flow-top{display:block}.flow-top p{margin-top:12px}.flow{display:flex;gap:0;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;-ms-overflow-style:none;scrollbar-width:none}.flow::-webkit-scrollbar{display:none}.flow:before{display:none}.flow-step{flex:0 0 100%;min-width:100%;min-height:160px;padding:24px 18px 22px;scroll-snap-align:start;animation:none}.flow-icon{width:56px;height:56px;border-radius:16px;font-size:24px;margin:0 auto 16px}.flow-step b{font-size:24px;margin-bottom:10px}.flow-step span{font-size:18px;line-height:1.55;max-width:320px;margin:0 auto}.flow-mobile-controls{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:18px}.live-window{height:310px}.necessity-grid{gap:30px}.cta-section{padding:62px 0}.footer-inner{display:block}.footer-links{margin-top:10px}}
@media(max-width:480px){h1{font-size:39px}.product-stage{min-height:360px}.browser-main .browser-view{height:280px}.browser-phone{width:46%}.browser-phone .browser-view{height:215px}.hero:before{width:80%;background-position:86% center;opacity:.4}.flow-shell{padding:24px 16px}.flow-step{min-height:150px;padding:22px 14px 20px}.flow-icon{width:50px;height:50px;font-size:22px}.flow-step b{font-size:22px}.flow-step span{font-size:16px;max-width:290px}.hero-actions .btn,.cta-actions .btn{width:100%}.hero-note{display:grid;gap:7px}.brand-name{font-size:15px}}
</style>
</head>
<body>
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="index.html" aria-label="TeamWorkt Safety home"><img src="assets/teamworkt-safety-logo.png" alt="TeamWorkt Safety logo"></a>
    <nav class="nav-links" aria-label="Primary navigation"><a href="#how-it-works">How it works</a><a href="#product">Product</a><a href="#getting-started">Getting started</a><a href="#why">Why it matters</a></nav>
    <a class="nav-cta" href="demo.html">View the demo</a>
  </div>
</header>

<main>
<section class="hero">
  <div class="container hero-grid">
    <div>
      <div class="kicker"><span class="kicker-dot"></span>Safety reporting that stays accountable</div>
      <h1>A simpler way to turn safety reports into action.</h1>
      <p class="hero-copy">TeamWorkt Safety gives employees an easy way to report hazards, near misses, injuries, and unsafe conditions from their phone. Management gets one clear workflow to review the report, assign corrective action, verify the work, and keep a complete record through closure.</p>
      <div class="hero-actions"><a class="btn btn-light" href="demo.html">See the live demo</a><a class="btn btn-ghost" href="report.html">Try employee reporting</a></div>
      <div class="hero-note"><span>Mobile friendly</span><span>No app download required</span><span>Company-branded URL</span><span>English and Spanish</span></div>
    </div>
    <div class="product-stage" aria-label="TeamWorkt Safety product previews">
      <div class="browser browser-main"><div class="browser-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div><div class="browser-view"><iframe src="dashboard.html" title="TeamWorkt Safety management dashboard preview" tabindex="-1" loading="eager"></iframe></div></div>
      <div class="browser browser-phone"><div class="browser-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div><div class="browser-view"><iframe src="report.html" title="TeamWorkt Safety reporting form preview" tabindex="-1" loading="eager"></iframe></div></div>
      <div class="preview-tag">Live demo screens</div>
    </div>
  </div>
</section>

<section class="section" id="problem">
  <div class="container">
    <div class="section-head reveal"><div class="eyebrow">The problem we solve</div><h2>The hard part is rarely getting a report. It is making sure something happens next.</h2><p>When safety information is spread across paper forms, text messages, email, and spreadsheets, follow-up can depend on memory. TeamWorkt Safety keeps the report and the response connected from the first submission through final verification.</p></div>
    <div class="problem-grid">
      <article class="problem reveal"><div class="problem-num">01</div><h3>Reports get scattered</h3><p>A photo might be in a text thread while the details live in an email or spreadsheet. Managers lose the full picture.</p></article>
      <article class="problem reveal"><div class="problem-num">02</div><h3>Ownership is unclear</h3><p>Everyone may know about the issue, but no one has a clear assignment, due date, or responsibility to close it.</p></article>
      <article class="problem reveal"><div class="problem-num">03</div><h3>Follow-up is inconsistent</h3><p>A problem can be called fixed without evidence, verification, or a clear record of what changed.</p></article>
      <article class="problem reveal"><div class="problem-num">04</div><h3>Records are hard to find</h3><p>Months later, reconstructing what happened, what was done, and who approved it can become its own project.</p></article>
    </div>
  </div>
</section>

<section class="section soft" id="how-it-works">
  <div class="container">
    <div class="flow-shell reveal">
      <div class="flow-top"><h2>One clear path from report to closure.</h2><p>The workflow is designed so employees can report quickly and managers always know what needs to happen next.</p></div>
      <div class="flow" aria-label="Safety workflow">
        <div class="flow-step"><div class="flow-icon">1</div><b>Report</b><span>Employee submits the concern</span></div>
        <div class="flow-step"><div class="flow-icon">2</div><b>Review</b><span>Management confirms what happened</span></div>
        <div class="flow-step"><div class="flow-icon">3</div><b>Assign</b><span>Corrective action gets an owner</span></div>
        <div class="flow-step"><div class="flow-icon">4</div><b>Complete</b><span>Work is finished and documented</span></div>
        <div class="flow-step"><div class="flow-icon">5</div><b>Verify</b><span>Management reviews the evidence</span></div>
        <div class="flow-step"><div class="flow-icon">6</div><b>Close</b><span>The final record stays available</span></div>
      </div>
      <div class="flow-mobile-controls" aria-label="Workflow step navigation">
        <button class="flow-mobile-btn" type="button" data-flow-prev aria-label="Previous workflow step">&#8249;</button>
        <div class="flow-mobile-dots">
          <button class="flow-mobile-dot is-active" type="button" data-flow-index="0" aria-label="View workflow step 1"></button>
          <button class="flow-mobile-dot" type="button" data-flow-index="1" aria-label="View workflow step 2"></button>
          <button class="flow-mobile-dot" type="button" data-flow-index="2" aria-label="View workflow step 3"></button>
          <button class="flow-mobile-dot" type="button" data-flow-index="3" aria-label="View workflow step 4"></button>
          <button class="flow-mobile-dot" type="button" data-flow-index="4" aria-label="View workflow step 5"></button>
          <button class="flow-mobile-dot" type="button" data-flow-index="5" aria-label="View workflow step 6"></button>
        </div>
        <button class="flow-mobile-btn" type="button" data-flow-next aria-label="Next workflow step">&#8250;</button>
      </div>
    </div>
  </div>
</section>

<section class="section" id="product">
  <div class="container split">
    <div class="split-copy reveal"><div class="eyebrow">For employees</div><h2>Reporting should take minutes, not training.</h2><p>Employees can open a mobile-friendly form from a link or QR code and report what they saw. The form is designed to collect useful information without making the reporter understand a complicated safety system.</p><div class="check-list">
      <div class="check"><div class="check-dot">✓</div><div><b>Fast mobile reporting</b><span>Hazards, near misses, unsafe conditions, equipment issues, and injuries can be submitted from the field.</span></div></div>
      <div class="check"><div class="check-dot">✓</div><div><b>Photos and supporting details</b><span>Give management useful context while the issue is still fresh.</span></div></div>
      <div class="check"><div class="check-dot">✓</div><div><b>English and Spanish</b><span>Support a workforce that may not all prefer the same language.</span></div></div>
    </div></div>
    <div class="live-frame reveal"><div class="browser-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div><div class="live-window"><iframe src="report.html" title="Employee safety reporting product view" tabindex="-1" loading="lazy"></iframe></div></div>
  </div>
</section>

<section class="section soft">
  <div class="container split reverse">
    <div class="split-copy reveal"><div class="eyebrow">For management</div><h2>Every open issue has a next step.</h2><p>Management gets one place to review reports, assign corrective action, set priority and due dates, collect evidence, request changes, verify completion, and preserve the closed record.</p><div class="check-list">
      <div class="check"><div class="check-dot">✓</div><div><b>Clear ownership</b><span>Assign work to the person responsible for completing the corrective action.</span></div></div>
      <div class="check"><div class="check-dot">✓</div><div><b>Evidence and verification</b><span>Completed work can be reviewed before management closes the issue.</span></div></div>
      <div class="check"><div class="check-dot">✓</div><div><b>History and PDF records</b><span>Keep the timeline, notes, attachments, and final record together.</span></div></div>
    </div></div>
    <div class="live-frame reveal"><div class="browser-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div><div class="live-window"><iframe src="dashboard.html" title="Management dashboard product view" tabindex="-1" loading="lazy"></iframe></div></div>
  </div>
</section>

<section class="section access-section" id="access-anywhere">
  <div class="container">
    <div class="section-head center reveal"><div class="eyebrow">Simple access for smaller teams</div><h2>No separate mobile app to manage.</h2><p>TeamWorkt Safety is designed to work directly in a modern browser on phones, tablets, and computers. That keeps employee access simple and helps smaller companies avoid the cost and maintenance of separate native iPhone and Android apps.</p></div>
    <div class="access-grid">
      <article class="access-card reveal"><div class="access-icon">01</div><h3>Open it from any device</h3><p>Employees can use a reporting link or QR code from the field, while managers can review and close reports from a phone, tablet, or computer. No App Store download is required.</p></article>
      <article class="access-card reveal"><div class="access-icon">02</div><h3>Optional home-screen access</h3><p>Customer deployments can be configured as a Progressive Web App, or PWA, so TeamWorkt Safety can be added to a phone home screen for fast, app-like access without maintaining a separate native app.</p></article>
      <article class="access-card reveal"><div class="access-icon">03</div><h3>Keep it under your company name</h3><p>With access to your company domain settings, your TeamWorkt Safety deployment can use a familiar branded subdomain instead of a separate vendor address.</p><div class="url-pill">safety.yourcompany.com</div></article>
    </div>
  </div>
</section>

<section class="section" id="getting-started">
  <div class="container">
    <div class="section-head center reveal"><div class="eyebrow">Easy to get started</div><h2>You provide the basics. We handle the setup.</h2><p>The goal is not to give your company another piece of software to configure. We set up the system around a simple, repeatable safety workflow and prepare your team to use it.</p></div>
    <div class="setup">
      <article class="setup-card reveal"><div class="n">STEP 1</div><h3>Share your company details</h3><p>Logo, colors, users, safety contacts, and the types of reports you want employees to submit.</p></article>
      <article class="setup-card reveal"><div class="n">STEP 2</div><h3>We configure the system</h3><p>Your reporting experience, roles, workflow, corrective-action process, and notifications are prepared for your team.</p></article>
      <article class="setup-card reveal"><div class="n">STEP 3</div><h3>Your administrator reviews it</h3><p>We walk through the system together, confirm the workflow, and make sure the team knows where to start.</p></article>
      <article class="setup-card reveal"><div class="n">STEP 4</div><h3>Launch to employees</h3><p>Share the reporting link or QR code and begin managing safety reports through one consistent process.</p></article>
    </div>
  </div>
</section>

<section class="section necessity" id="why">
  <div class="container necessity-grid">
    <div class="quote-card reveal"><div class="eyebrow">Why it matters</div><strong>A safety report only helps if the organization can follow it through to a documented result.</strong><p>TeamWorkt Safety is designed to make that follow-through visible. It does not replace professional safety, legal, or regulatory advice. It gives your team a practical system for managing the work that happens after a concern is reported.</p><div class="fit-row"><span class="fit">Construction trades</span><span class="fit">HVAC</span><span class="fit">Electrical</span><span class="fit">Roofing</span><span class="fit">Field service</span><span class="fit">Light manufacturing</span></div></div>
    <div class="why-list">
      <article class="why reveal"><h3>Consistent intake</h3><p>Employees have one known place to report a safety concern instead of deciding who to text, call, or email.</p></article>
      <article class="why reveal"><h3>Visible accountability</h3><p>Corrective actions have an owner, status, due date, and clear place in the workflow.</p></article>
      <article class="why reveal"><h3>Management verification</h3><p>Completion is reviewed before the report is closed, helping teams avoid informal handoffs and assumptions.</p></article>
      <article class="why reveal"><h3>Better recordkeeping</h3><p>Report details, actions, evidence, notes, and final status stay connected in one record.</p></article>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container cta-box">
    <div class="cta-copy reveal"><div class="eyebrow">See it in action</div><h2>Walk through the full safety workflow in about five minutes.</h2><p>The demonstration uses browser-only sample records, so you can explore the reporting and management experience without creating live company data. If it looks close to what your team needs, email <a href="mailto:hello@teamworktsafety.com" style="color:#fff;font-weight:700;text-decoration:underline;text-underline-offset:3px">hello@teamworktsafety.com</a> and we can walk through it together in about 15 minutes.</p></div>
    <div class="cta-actions reveal"><a class="btn btn-light" href="demo.html">Open guided demo</a><a class="btn btn-ghost" href="dashboard.html">Open dashboard</a></div>
  </div>
</section>
</main>

<footer><div class="container footer-inner"><div><img class="footer-brand-logo" src="assets/teamworkt-safety-logo.png" alt="TeamWorkt Safety logo">Simple safety reporting and corrective-action workflow.<br><a href="mailto:hello@teamworktsafety.com" style="display:inline-block;margin-top:7px;color:#d6e6f3;text-decoration:none">hello@teamworktsafety.com</a></div><div class="footer-links"><a href="report.html">Employee demo</a><a href="dashboard.html">Management demo</a><a href="demo.html">Guided demo</a></div></div></footer>

<script>
(function(){
  var items=document.querySelectorAll('.reveal');
  if(!('IntersectionObserver' in window)){items.forEach(function(el){el.classList.add('visible')});return;}
  var io=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(entry.isIntersecting){entry.target.classList.add('visible');io.unobserve(entry.target);}})},{threshold:.12});
  items.forEach(function(el){io.observe(el)});
})();

(function(){
  var flow=document.querySelector('.flow');
  if(!flow)return;
  var steps=Array.prototype.slice.call(flow.querySelectorAll('.flow-step'));
  var dots=Array.prototype.slice.call(document.querySelectorAll('[data-flow-index]'));
  var prev=document.querySelector('[data-flow-prev]');
  var next=document.querySelector('[data-flow-next]');
  var mobile=window.matchMedia('(max-width: 720px)');
  var activeIndex=0;

  function setActive(index){
    activeIndex=Math.max(0,Math.min(index,steps.length-1));
    dots.forEach(function(dot,i){dot.classList.toggle('is-active',i===activeIndex);});
    if(prev) prev.disabled=activeIndex===0;
    if(next) next.disabled=activeIndex===steps.length-1;
  }

  function goTo(index){
    if(!mobile.matches)return;
    var step=steps[index];
    if(!step)return;
    flow.scrollTo({left:step.offsetLeft,behavior:'smooth'});
    setActive(index);
  }

  function syncFromScroll(){
    if(!mobile.matches)return;
    var width=flow.clientWidth || 1;
    var index=Math.round(flow.scrollLeft/width);
    setActive(index);
  }

  if(prev) prev.addEventListener('click',function(){goTo(activeIndex-1);});
  if(next) next.addEventListener('click',function(){goTo(activeIndex+1);});
  dots.forEach(function(dot){
    dot.addEventListener('click',function(){goTo(parseInt(dot.getAttribute('data-flow-index'),10)||0);});
  });
  flow.addEventListener('scroll',function(){window.requestAnimationFrame(syncFromScroll);},{passive:true});
  window.addEventListener('resize',function(){setActive(mobile.matches ? Math.round(flow.scrollLeft/(flow.clientWidth||1)) : 0);});
  setActive(0);
})();
</script>
</body>
</html>
